<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.SpeedPlayOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Center"
    VerticalAlignment="Top"
    mc:Ignorable="d">

    <Border
        Margin="0,12,0,0"
        Background="#E62B2B2B"
        CornerRadius="8"
        IsHitTestVisible="False"
        Visibility="{x:Bind ViewModel.IsHoldingSpeedChanging, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation
                From="0.0"
                To="1.0"
                Duration="0:0:0.15" />
            <animations:TranslationAnimation
                From="0,-16,0"
                To="0,0,0"
                Duration="0:0:0.2" />
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:OpacityAnimation
                From="1.0"
                To="0.0"
                Duration="0:0:0.15" />
            <animations:TranslationAnimation
                From="0,0,0"
                To="0,-16,0"
                Duration="0:0:0.2" />
        </animations:Implicit.HideAnimations>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Margin="14,8"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#B3FFFFFF"
                    Glyph="&#xE769;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{ext:Locale Name=TempSpeedPlaying}" />
            </StackPanel>
            <Rectangle
                Grid.Column="1"
                Margin="0,6"
                Fill="#26FFFFFF" />
            <Border
                Grid.Column="2"
                Padding="10,5"
                Background="#E61A1A1A"
                CornerRadius="0,8,8,0">
                <StackPanel MinWidth="40">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="10"
                        Foreground="#99FFFFFF"
                        Text="{ext:Locale Name=TempSpeedSmart}" />
                    <StackPanel
                        x:Name="SpeedOptions"
                        HorizontalAlignment="Right"
                        Spacing="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:PlayerControlBase>
