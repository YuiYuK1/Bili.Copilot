<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.SponsorBlockSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sponsorblock="using:BiliCopilot.UI.SponsorBlock"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SponsorBlockBehaviorConverter x:Key="SponsorBlockBehaviorConverter" />
    </UserControl.Resources>

    <base:SettingsExpander Description="{ext:Locale Name=SponsorBlockDescription}" Header="{ext:Locale Name=SponsorBlock}">
        <base:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="FlashAuto" />
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard Description="{ext:Locale Name=SponsorBlockEnabledDescription}" Header="{ext:Locale Name=SponsorBlockEnabled}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsSponsorBlockEnabled, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard
                Description="{ext:Locale Name=AutoSkipSponsorDescription}"
                Header="{ext:Locale Name=AutoSkipSponsor}"
                Visibility="{x:Bind ViewModel.IsSponsorBlockEnabled, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AutoSkipSponsor, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard
                ContentAlignment="Left"
                Description="{ext:Locale Name=SponsorBlockBehaviorDescription}"
                Header="{ext:Locale Name=SponsorBlockBehavior}"
                HorizontalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsSponsorBlockEnabled, Mode=OneWay}">
                <ItemsRepeater
                    Margin="0,8,0,0"
                    ItemsSource="{x:Bind ViewModel.SponsorBlockCategorySettings, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="260"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:SponsorBlockCategorySettingViewModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="128"
                                    ItemsSource="{x:Bind AvailableBehaviors}"
                                    SelectedItem="{x:Bind Behavior, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="sponsorblock:SponsorBlockBehavior">
                                            <TextBlock Text="{x:Bind Converter={StaticResource SponsorBlockBehaviorConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </base:SettingsCard>
        </base:SettingsExpander.Items>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
